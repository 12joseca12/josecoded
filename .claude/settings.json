{
  "enabledPlugins": {
    "superpowers@claude-plugins-official": true,
    "cloudflare@claude-plugins-official": true,
    "impeccable@impeccable": true,
    "taste-skill@taste-skill": true,
    "gsap-skills@gsap-skills": true
  },
  "extraKnownMarketplaces": {
    "impeccable": { "source": { "source": "github", "repo": "pbakaus/impeccable" } },
    "taste-skill": { "source": { "source": "github", "repo": "Leonxlnx/taste-skill" } },
    "gsap-skills": { "source": { "source": "github", "repo": "greensock/gsap-skills" } }
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume",
        "hooks": [
          { "type": "command", "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/estado-sesion.sh", "timeout": 5 }
        ]
      }
    ]
  }
}
