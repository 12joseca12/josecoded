# Copy to `.dev.vars` in this folder (apps/api). Wrangler loads it on `pnpm dev`. Never commit `.dev.vars`.

# --- Supabase local (`supabase start`, then `supabase status` for the keys) ---
SUPABASE_URL=http://127.0.0.1:54321
# Publishable key: same value as NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY of apps/web
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Secret key (bypasses RLS): outbox, scheduled jobs, staff_members. Only the gateway has it.
SUPABASE_SECRET_KEY=sb_secret_...
# The seed accounts have no TOTP: only locally, let requireAdmin accept aal1. Never in production or preview.
ADMIN_REQUIRE_MFA=false

# --- Outbox notifications (job outbox.drain). Without both, the drain claims nothing. ---
# TELEGRAM_BOT_TOKEN=123456:...
# TELEGRAM_ADMIN_CHAT_ID=123456789
# Email channel (Resend), not used by any launch event yet
# RESEND_API_KEY=re_...

# --- Public modules (proposals 3.7, leads 3.8) ---
# Turnstile always-pass dummy secret for local runs (https://developers.cloudflare.com/turnstile/troubleshooting/testing/)
# TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
# openssl rand -hex 32. Signs proposalToken and authenticates server-to-server leads (header x-josecoded-server-key)
# SERVER_KEY=
# AI Gateway id (Workers AI is only called through it); wrangler.jsonc sets "josecoded" for production
# AI_GATEWAY_ID=josecoded
# PROPOSALS_DAILY_LIMIT_IP=10
# PROPOSALS_DAILY_LIMIT_ALL=300

# --- Chat (task 4.4): openssl rand -hex 32 ---
# CHAT_SID_SECRET=
# CHAT_DAILY_THREADS_IP=20
# CHAT_DAILY_THREADS_ALL=500
# CHAT_DAILY_MESSAGES_IP=40
# CHAT_DAILY_MESSAGES_ALL=2000
# AI_ASSISTANT_MODEL=@cf/meta/llama-3.3-70b-instruct-fp8-fast

# --- Optional backend on Omen (Fastify), NOT this Worker's URL. Both or neither; not set in production. ---
# WORKER_URL=https://worker.josecoded.com
# Must be EXACTLY the BACKEND_INTERNAL_TOKEN of the backend
# WORKER_INTERNAL_TOKEN=paste_the_backend_hex_token_here
# With WORKER_URL and API_MODE=development, DEV_API_KEY mounts /api/dev/worker/* (header x-dev-api-key)
# DEV_API_KEY=
