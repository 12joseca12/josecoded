{
  "name": "josecoded-api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node ./scripts/wrangler-dev.mjs",
    "deploy": "wrangler deploy",
    "build": "wrangler deploy --dry-run --outdir dist && wrangler deploy --dry-run --env preview --outdir .wrangler/preview-bundle && node scripts/check-no-test-hooks.mjs dist .wrangler/preview-bundle",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@josecoded/types": "workspace:*",
    "@supabase/supabase-js": "2.117.2",
    "hono": "4.13.12",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "0.22.0",
    "@cloudflare/workers-types": "5.20260925.2",
    "@josecoded/config": "workspace:*",
    "@types/node": "22.20.2",
    "eslint": "10.10.0",
    "typescript": "5.9.3",
    "vitest": "4.1.11",
    "wrangler": "4.133.0"
  }
}
