# Public variables (inlined at build time, never secrets). Copy to .env.local.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_JOSECODED_API_URL=http://localhost:8787
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_local
# Cloudflare Turnstile always-pass test key
NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
NEXT_PUBLIC_CAL_LINK=josecoded/20min
NEXT_PUBLIC_WHATSAPP_NUMBER=34600000000
NEXT_PUBLIC_HERO_MEDIA_VERSION=1
# Optional
NEXT_PUBLIC_UMAMI_WEBSITE_ID=
NEXT_PUBLIC_CF_BEACON_TOKEN=
# '1' in local and preview builds to expose the /dev/ui catalogue (task 2.2); leave unset in production
NEXT_PUBLIC_DEV_UI=1
