{
  "name": "@josecoded/web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "generate": "node scripts/build-info.ts && node scripts/content-index.ts && node scripts/csp-config.ts",
    "dev": "pnpm run generate && pnpm run og && next dev",
    "build": "opennextjs-cloudflare build",
    "preview": "opennextjs-cloudflare preview",
    "lint": "pnpm run generate && eslint . && stylelint \"**/*.css\" --allow-empty-input",
    "typecheck": "pnpm run generate && tsc --noEmit",
    "test": "pnpm run generate && vitest run",
    "og": "node scripts/og.ts",
    "content:refresh": "node scripts/github.ts && node scripts/stores.ts && node scripts/content-index.ts",
    "i18n:check": "node scripts/i18n-check.ts",
    "e2e": "playwright test",
    "check:hero-bundle": "node scripts/check-hero-bundle.ts",
    "lhci": "lhci autorun --config=lighthouserc.json && lhci autorun --config=lighthouserc.desktop.json",
    "lhci:assert-lcp-element": "node scripts/lhci-assert-lcp-element.ts"
  },
  "dependencies": {
    "@josecoded/glyph-scene": "workspace:*",
    "@josecoded/pricing": "workspace:*",
    "@josecoded/types": "workspace:*",
    "@opennextjs/cloudflare": "1.20.6",
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.117.2",
    "lucide-react": "1.58.0",
    "next": "16.3.6",
    "next-intl": "4.14.5",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@josecoded/config": "workspace:*",
    "@lhci/cli": "0.15.1",
    "@playwright/test": "1.63.0",
    "@testing-library/react": "16.3.3",
    "@types/node": "22.20.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "10.10.0",
    "happy-dom": "20.14.5",
    "stylelint": "17.16.0",
    "typescript": "5.9.3",
    "vitest": "4.1.11",
    "vitest-axe": "0.1.0",
    "wrangler": "4.133.0"
  }
}
