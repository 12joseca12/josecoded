{
  "extends": "@josecoded/config/tsconfig.next.json",
  "compilerOptions": {
    "types": ["node"],
    "paths": {
      "@/*": ["./*"],
      "@josecoded/types": ["../../packages/types/src/index.ts"]
    }
  },
  "include": [
    "next-env.d.ts",
    "global.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts"
  ],
  "exclude": ["node_modules", ".next", ".open-next"]
}
