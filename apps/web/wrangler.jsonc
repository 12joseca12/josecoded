{
  "name": "josecoded-web",
  // worker.mjs wraps OpenNext's .open-next/worker.js to add the Content-Security-Policy (hashes of each page's inline scripts)
  "main": "worker.mjs",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": { "directory": ".open-next/assets", "binding": "ASSETS" },
  "preview_urls": true,
  "observability": { "enabled": true },
  // Throttle of the code steps (lib/auth/rate-limit.ts): per network (IPv4 / IPv6 /64) and per account. Account limit 5 per minute:
  // with a 10-minute code (otp_expiry = 600) that caps guessing well under 0.5% of the 10^6 space per location.
  "ratelimits": [
    { "name": "AUTH_IP_RATE_LIMITER", "namespace_id": "3001", "simple": { "limit": 20, "period": 60 } },
    { "name": "AUTH_SUBJECT_RATE_LIMITER", "namespace_id": "3002", "simple": { "limit": 5, "period": 60 } }
  ],
  // No `routes` until task 9.6 (custom domain josecoded.com). Target: Workers Free.
}
