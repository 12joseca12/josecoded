{
  "name": "josecoded",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm content:build && next dev",
    "build": "pnpm content:build && next build",
    "start": "next start",
    "cf:build": "opennextjs-cloudflare build",
    "cf:build:production": "node scripts/assert-site-url.js && opennextjs-cloudflare build",
    "cf:preview": "opennextjs-cloudflare preview --env preview",
    "cf:deploy:preview": "opennextjs-cloudflare deploy --env preview",
    "lint": "eslint .",
    "lint:css": "stylelint \"src/**/*.css\" --allow-empty-input",
    "lint:rules": "node --test tests/lint/rules.test.js",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "e2e": "playwright test",
    "content:build": "node scripts/content.js --write",
    "content:check": "node scripts/content.js",
    "i18n:keys": "node scripts/i18n.js --write",
    "i18n:check": "node scripts/i18n.js",
    "tokens:types": "node scripts/tokens.js --write",
    "tokens:check": "node scripts/tokens.js",
    "tokens:test": "node --test tests/tokens/contrast.test.js",
    "db:types": "supabase gen types typescript --project-id echlwywbucgbhwpncviy --schema public > src/types/database.ts.tmp && mv src/types/database.ts.tmp src/types/database.ts",
    "db:test:local": "bash supabase/local/run-tests.sh"
  },
  "dependencies": {
    "@mdx-js/loader": "3.1.1",
    "@mdx-js/react": "3.1.1",
    "@next/mdx": "16.4.3",
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.119.0",
    "motion": "14.6.0",
    "next": "16.4.3",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "rehype-autolink-headings": "7.1.0",
    "rehype-slug": "6.0.0",
    "remark-frontmatter": "5.0.0",
    "remark-gfm": "4.0.1",
    "server-only": "0.0.1",
    "yaml": "2.9.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@eslint/js": "10.0.1",
    "@opennextjs/cloudflare": "1.20.12",
    "@playwright/test": "1.64.1",
    "@types/mdx": "2.0.14",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "10.13.0",
    "eslint-config-next": "16.4.2",
    "eslint-plugin-simple-import-sort": "13.0.0",
    "prettier": "3.9.10",
    "stylelint": "17.16.0",
    "stylelint-declaration-strict-value": "1.12.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.2",
    "vitest": "4.1.12",
    "wrangler": "4.151.1"
  }
}
