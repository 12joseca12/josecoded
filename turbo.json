{
  "$schema": "https://turbo.build/schema.json",
  "globalPassThroughEnv": ["GITHUB_PR_HEAD_SHA", "GITHUB_HEAD_REF", "GITHUB_REF_NAME", "GITHUB_SHA", "WORKERS_CI_BRANCH", "WORKERS_CI_COMMIT_SHA"],
  "tasks": {
    "lint": {},
    "typecheck": {},
    "test": {
      "dependsOn": ["^build"],
      "passThroughEnv": ["TARIFAS_PATH"]
    },
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", ".open-next/**", "dist/**"],
      "env": ["NEXT_PUBLIC_*"]
    },
    "e2e": {
      "cache": false,
      "dependsOn": ["build"],
      "env": ["NEXT_PUBLIC_*"],
      "passThroughEnv": ["PW_CHANNEL", "CI"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "tokens:build": {
      "cache": false
    },
    "visual": {
      "cache": false
    },
    "i18n:check": {},
    "pricing:sync": {
      "cache": false
    },
    "pricing:sync-db": {
      "cache": false
    },
    "hero:media": {
      "cache": false
    },
    "hero:media:check": {
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/apps/web/public/hero/**",
        "$TURBO_ROOT$/apps/web/public/art/**",
        "$TURBO_ROOT$/packages/types/src/schemas/media.ts"
      ]
    },
    "check:hero-bundle": {},
    "lhci": {
      "cache": false
    },
    "lhci:assert-lcp-element": {
      "cache": false
    }
  }
}
