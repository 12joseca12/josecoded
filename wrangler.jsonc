{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "josecoded-preview",
  "main": "cloudflare/worker.js",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS",
  },
  "observability": {
    "enabled": true,
  },
  "triggers": {
    "crons": ["*/2 * * * *"],
  },
  "vars": {
    "NEXT_PUBLIC_SUPABASE_URL": "https://echlwywbucgbhwpncviy.supabase.co",
    "NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY": "sb_publishable__n1YoCk8hC4R4QIhyThvMw_BY2G1p07",
    "NEXT_PUBLIC_TURNSTILE_SITE_KEY": "0x4AAAAAAFzkPPhv9hUKSaBY",
  },
  "ratelimits": [
    { "name": "CONTACT_LIMITER", "namespace_id": "1001", "simple": { "limit": 10, "period": 60 } },
    { "name": "AUTH_LIMITER", "namespace_id": "1003", "simple": { "limit": 5, "period": 60 } },
    { "name": "CHAT_LIMITER", "namespace_id": "1007", "simple": { "limit": 60, "period": 60 } },
    {
      "name": "AUTH_EMAIL_LIMITER",
      "namespace_id": "1005",
      "simple": { "limit": 20, "period": 60 },
    },
  ],
  "env": {
    "preview": {
      "name": "josecoded-preview",
      "workers_dev": true,
      "triggers": {
        "crons": ["*/2 * * * *"],
      },
      "preview_urls": true,
      "assets": {
        "directory": ".open-next/assets",
        "binding": "ASSETS",
      },
      "ratelimits": [
        {
          "name": "CONTACT_LIMITER",
          "namespace_id": "1002",
          "simple": { "limit": 10, "period": 60 },
        },
        {
          "name": "CHAT_LIMITER",
          "namespace_id": "1008",
          "simple": { "limit": 60, "period": 60 },
        },
        {
          "name": "AUTH_LIMITER",
          "namespace_id": "1004",
          "simple": { "limit": 5, "period": 60 },
        },
        {
          "name": "AUTH_EMAIL_LIMITER",
          "namespace_id": "1006",
          "simple": { "limit": 20, "period": 60 },
        },
      ],
      "vars": {
        "ENABLE_DEV_PAGES": "true",
        "NEXT_PUBLIC_SITE_URL": "https://josecoded-preview.josecoded-api.workers.dev",
        "NEXT_PUBLIC_SUPABASE_URL": "https://echlwywbucgbhwpncviy.supabase.co",
        "NEXT_PUBLIC_TURNSTILE_SITE_KEY": "0x4AAAAAAFzkPPhv9hUKSaBY",
        "NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY": "sb_publishable__n1YoCk8hC4R4QIhyThvMw_BY2G1p07",
      },
    },
  },
}
